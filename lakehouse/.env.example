# Lab-only credentials for the local MinIO that stores the Iceberg files.
# Copy to lakehouse/.env (git-ignored). Never reuse these anywhere real.
MINIO_ROOT_USER=lakehouse
MINIO_ROOT_PASSWORD=changeme-lab-only

# Host ports (chosen to avoid the main stack and the other Trino project)
TRINO_PORT=8085
MINIO_API_PORT=9102
MINIO_CONSOLE_PORT=9103
ICEBERG_REST_PORT=8183
