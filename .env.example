# Local lab only -- plaintext creds are fine here, never reuse these in a real deployment.

# --- Superset metadata DB (Postgres) ---
POSTGRES_HOST=postgres
POSTGRES_USER=superset
POSTGRES_PASSWORD=changeme
POSTGRES_DB=superset
SUPERSET_EXAMPLES_DB_NAME=superset_examples

# --- Superset app ---
SUPERSET_SECRET_KEY=changeme
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=changeme
SUPERSET_ADMIN_EMAIL=admin@example.com
SUPERSET_BASE_URL=http://superset:8088

# TASK 2 knobs: "before" state reproduces the silent timeout bug (15s webserver
# timeout vs. an 18s slow query, under the 20s DB statement_timeout). See intermittent-error/README / WRITEUP.md for
# the "after" values to switch to once the fix is applied.
SUPERSET_WEBSERVER_TIMEOUT=15
GUNICORN_WORKERS=2
SLOW_QUERY_SLEEP_SECONDS=18
# How long Superset reuses a cached chart result (the "error, then fine on refresh" window)
CACHE_TIMEOUT_SECONDS=300

# --- seed script tuning (optional, defaults are fine) ---
SEED_FAKE_USER_COUNT=12
SEED_DAYS_OF_HISTORY=30
SEED_SESSIONS_PER_DAY=40

# --- Iceberg (read and written through Trino): the pipeline's only data store ---
# For the lab: start lakehouse/ and use lakehouse/connect-pipeline.yml, which sets these for the pipeline.
# Against the bank's real Trino, set them here (and TRINO_PASSWORD for TLS/auth).
TRINO_HOST=trino
TRINO_PORT=8080
TRINO_USER=pipeline
TRINO_CATALOG=iceberg
TRINO_SCHEMA=monitoring
# rows per MERGE (one statement per table per chunk, not per API page); keep the statement under Trino's query size limit
ICEBERG_BATCH_ROWS=2000
# raw log payloads are large: a MERGE of raw rows is cut at this many rows or characters, whichever comes first
ICEBERG_RAW_BATCH_ROWS=300
ICEBERG_RAW_BATCH_CHARS=400000
# how often a MERGE that lost an Iceberg commit race is retried (it is idempotent, so retrying is safe)
ICEBERG_COMMIT_RETRIES=6
# single-writer lease: a crashed run's lock expires after this many minutes
ETL_LOCK_TTL_MINUTES=30
# table maintenance (compaction, snapshot expiry, orphan files): runs when the last one is older than this many hours.
# ICEBERG_RETENTION must not be shorter than the catalog's minimum (Trino default 7d).
MAINTENANCE_INTERVAL_HOURS=24
ICEBERG_RETENTION=7d
ICEBERG_OPTIMIZE_FILE_SIZE=128MB
# etl_run_log (one row per run) is pruned after this many days
ETL_RUN_LOG_DAYS=90
# request paths whose HTTP errors (status >= 400) are logged by Superset and ingested (comma separated prefixes)
ERROR_TRACE_PREFIXES=/api/v1/chart,/api/v1/dashboard,/api/v1/explore,/api/v1/dataset,/api/v1/sqllab,/superset/dashboard,/superset/explore_json
# the ETL re-reads this many hours before its watermark, so late or clock-skewed rows are not skipped
ETL_LOOKBACK_HOURS=24
# Do authorization denials (HTTP 401/403, "access denied") count as dashboard failures? Default false: a user without
# access is expected behaviour, not a reliability problem. They are always reported separately as authorization_denied.
# Set true if, in your environment, a wave of denials would mean something is broken (a bad role sync, an SSO outage).
AUTHZ_COUNTS_AS_FAILURE=false
# a chart load slower than this counts as a slow load in the dashboards (agree the value with the business)
SLOW_LOAD_MS=5000
# share of synthetic failed chart loads the seed script generates (0 disables)
SEED_ERROR_RATE=0.03
