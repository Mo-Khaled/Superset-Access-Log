# Local lab only -- plaintext creds are fine here, never reuse these in a real deployment.

# --- Superset metadata DB (Postgres) ---
POSTGRES_HOST=postgres
POSTGRES_USER=superset
POSTGRES_PASSWORD=changeme
POSTGRES_DB=superset
SUPERSET_EXAMPLES_DB_NAME=superset_examples

# --- Superset app ---
SUPERSET_SECRET_KEY=changeme
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=changeme
SUPERSET_ADMIN_EMAIL=admin@example.com
SUPERSET_BASE_URL=http://superset:8088

# TASK 2 knobs: "before" state reproduces the silent timeout bug (15s webserver
# timeout vs. an 18s slow query, under the 20s DB statement_timeout). See intermittent-error/README / WRITEUP.md for
# the "after" values to switch to once the fix is applied.
SUPERSET_WEBSERVER_TIMEOUT=15
GUNICORN_WORKERS=2
SLOW_QUERY_SLEEP_SECONDS=18

# --- MySQL: access-log-pipeline destination, separate from Superset's own DB ---
MYSQL_ROOT_PASSWORD=changeme
MYSQL_DATABASE=access_log_pipeline
MYSQL_USER=pipeline
MYSQL_PASSWORD=changeme
MYSQL_HOST=mysql
MYSQL_PORT=3306

# --- seed script tuning (optional, defaults are fine) ---
SEED_FAKE_USER_COUNT=12
SEED_DAYS_OF_HISTORY=30
SEED_SESSIONS_PER_DAY=40
